# The show server: serves the built app on the LAN, relays the phone remote,
# listens for OSC, and sends Art-Net to the lighting rig.
#
#   sudo cp server/chromaglass.service /etc/systemd/system/
#   sudo systemctl enable --now chromaglass
#
# See docs/appliance.md. Edit User and WorkingDirectory if the clone is not in
# /home/pi/chromaglass.

[Unit]
Description=ChromaGlass show server
# Not network-online.target: the server binds 0.0.0.0 and does not care whether
# an address has arrived yet, and waiting for one adds seconds to a boot that a
# room is watching.
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/chromaglass
ExecStart=/usr/bin/node server/remote-server.js
# A show key that survives a reboot: the printed random one changes every time,
# which means re-typing it into every phone after a power cut.
Environment=SHOW_KEY=changeme
# Art-Net to the rig — see docs/appliance.md. Nothing is sent without a host.
# Environment=ARTNET_HOST=10.0.0.255
# Environment=ARTNET_FIXTURES=6
# Environment=ARTNET_ORDER=rgbw
Restart=always
RestartSec=2
# A box in a venue is unplugged rather than shut down, so the journal is the
# only record of what it was doing.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
