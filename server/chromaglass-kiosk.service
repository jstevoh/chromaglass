# The browser, full screen on the HDMI output, pointed at the show server.
#
#   sudo cp server/chromaglass-kiosk.service /etc/systemd/system/
#   sudo systemctl enable --now chromaglass-kiosk
#
# Every flag is explained in docs/appliance.md. The two that a show actually
# fails without are --autoplay-policy (there is nobody to click, so without it
# the plate runs and hears nothing) and --noerrdialogs (a box that lost power
# mid-set must not come back asking about restoring tabs, over the projection).

[Unit]
Description=ChromaGlass kiosk display
After=chromaglass.service graphical.target
Wants=chromaglass.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
# Wait for the server to answer rather than racing it: a kiosk that opens too
# early shows a connection error full screen and never reloads.
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:3000/ >/dev/null; do sleep 1; done'
ExecStart=/usr/bin/chromium \
  --kiosk \
  --autoplay-policy=no-user-gesture-required \
  --noerrdialogs \
  --disable-session-crashed-bubble \
  --disable-infobars \
  --check-for-update-interval=31536000 \
  --disable-features=Translate,MediaRouter \
  --use-gl=egl \
  --enable-features=VaapiVideoDecoder \
  'http://localhost:3000/?kiosk=1'
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
